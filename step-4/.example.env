# -------------------------------------------------------
# Container user (Docker Engine only, not Docker Desktop)
# -------------------------------------------------------
#UID=1000
#GID=1000

# -------------------------------------------------------
# AWS
# -------------------------------------------------------
#AWS_PROFILE=
AWS_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/github-actions-iac
AWS_TF_STATE_BUCKET=my-terraform-state
AWS_TF_STATE_REGION=us-east-1
AWS_REGION=us-east-1

# -------------------------------------------------------
# Terraform variables
# -------------------------------------------------------
APP_UNIQUE_ID=oauth2-app

# Service URLs — set to ECS Express Gateway endpoints after first deployment.
# FRONTEND_URL=https://xxx.us-east-1.express.ecs.aws
# BACKEND_URL=https://yyy.us-east-1.express.ecs.aws

# IMAGE_TAG=latest
